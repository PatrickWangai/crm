DATABASE_URL="postgresql://user@localhost:5432/masterways_crm?schema=public"
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"
NODE_ENV="development"

# Shared secret for POST /api/public/support-requests — the server-to-server
# bridge the standalone customer Help & Support app (separate repo) uses to
# create real Tickets here. Must match that app's own PUBLIC_API_KEY exactly.
PUBLIC_API_KEY="replace-with-a-long-random-string"

# Cloudflare R2 (S3-compatible) document storage. Optional in dev — without
# all four set, uploads fall back to local disk (src/lib/storage/local.ts),
# which is fine for local dev but gets wiped on every Render redeploy in
# production. Create a bucket + API token at dash.cloudflare.com > R2.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""

# Resend (resend.com) — sends the department-watcher emails for new
# requests, acceptances and completions (src/lib/notifications/ticket-events.ts).
# Optional — without it, those events still create in-app notifications,
# they just skip the email. RESEND_FROM_EMAIL can stay unset while testing;
# it falls back to Resend's shared onboarding@resend.dev sender.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# Absolute base URL used to build links inside emails (can't use relative
# paths in an email client). Defaults to the production URL if unset.
APP_URL=""
